#!/usr/bin/python3
"""Guest-derived revision receipt; gated on the fixed payload's proven reload contract."""
import hashlib
import http.client
import json
from pathlib import Path
import socket
import subprocess
import sys
import time

class UnixHTTP(http.client.HTTPConnection):
    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(self.timeout)
        self.sock.connect("/run/sub2-kernel/kernel.sock")

operation = sys.argv[1] if len(sys.argv) == 2 else ""
if operation not in ("apply", "observe"):
    raise SystemExit("unsupported_operation")
instance = json.loads(Path("/run/kin/instance.json").read_text())
revision = json.loads(Path("/run/sub2-credentials/revision.json").read_text())
credential = Path("/run/sub2-credentials/credential.json").read_bytes()
if hashlib.sha256(credential).hexdigest() != revision["digest"] or revision["revision"] != instance["desired_credential_revision"]:
    raise SystemExit("guest_projection_mismatch")
proxy = json.loads(Path("/run/sub2-credentials/proxy.json").read_text())
if proxy["revision"] != instance["spec"]["proxy_revision"]:
    raise SystemExit("guest_proxy_revision_mismatch")
boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
stamp = {"guest_boot_id": boot, "generation": instance["generation"],
         "credential_revision": revision["revision"], "proxy_revision": proxy["revision"]}
control_dir = Path("/run/sub2-control")
control_dir.mkdir(mode=0o700, exist_ok=True)
receipt = control_dir / "applied.json"
try:
    applied = json.loads(receipt.read_text())
except (OSError, ValueError):
    applied = None
if operation == "apply" and applied != stamp:
    subprocess.run(["systemctl", "restart", "sub2-kernel.service"], check=True)
deadline = time.monotonic() + (20 if operation == "apply" else 1)
ready = False
while True:
    try:
        conn = UnixHTTP("kernel", timeout=1)
        token = json.loads(Path("/run/kin/kernel.json").read_text())["internal_token"]
        conn.request("GET", "/internal/health", headers={"x-kin-internal-token": token})
        res = conn.getresponse()
        health = json.loads(res.read(1024*1024))
        ready = res.status == 200 and health.get("healthy") is not False and health.get("ok") is True
        conn.close()
        if ready: break
    except (OSError, ValueError, http.client.HTTPException):
        pass
    if time.monotonic() > deadline: break
    time.sleep(.2)
if operation == "apply":
    if not ready: raise SystemExit("guest_kernel_not_ready")
    temporary = receipt.with_suffix(".tmp")
    temporary.write_text(json.dumps(stamp))
    temporary.chmod(0o600)
    temporary.replace(receipt)
    applied = stamp
if applied != stamp:
    raise SystemExit("guest_application_unconfirmed")
print(json.dumps({**stamp, "kernel_ready": ready}))
