#!/usr/bin/python3
import json
import os
from pathlib import Path
import subprocess
from urllib.parse import urlparse

def run(*args):
    subprocess.run(args, check=True)

run("modprobe", "9pnet_virtio")
for tag, target, readonly in (("home", "/home/kincli", False), ("run", "/run/kin", True),
                              ("credentials", "/run/sub2-credentials", True),
                              ("payload", "/opt/sub2-payload", True)):
    Path(target).mkdir(parents=True, exist_ok=True)
    run("mount", "-t", "9p", "-o", "trans=virtio,version=9p2000.L,cache=none"+(",ro" if readonly else ""), "sub2"+tag, target)
instance = json.loads(Path("/run/kin/instance.json").read_text())
identity = instance["identity"]
run("hostnamectl", "set-hostname", identity["hostname"])
Path("/etc/machine-id").write_text(identity["machine_id"] + "\n")
try:
    import pwd
    existing = pwd.getpwnam("kincli")
    if existing.pw_uid != 10001:
        raise SystemExit("guest_uid_conflict")
except KeyError:
    run("useradd", "-u", "10001", "-M", "-d", "/home/kincli", "-s", "/usr/sbin/nologin", "kincli")
os.chown("/home/kincli", 10001, 10001)
claude = Path("/home/kincli/.claude")
claude.mkdir(exist_ok=True)
os.chown(claude, 10001, 10001)
for name in ("credentials.json", ".credentials.json"):
    link = claude / name
    if link.exists() or link.is_symlink():
        if not link.is_symlink() or os.readlink(link) != "/run/sub2-credentials/credential.json":
            raise SystemExit("guest_credential_path_conflict")
    else:
        link.symlink_to("/run/sub2-credentials/credential.json")
proxy = json.loads(Path("/run/sub2-credentials/proxy.json").read_text())
host = urlparse(proxy["url"]).hostname
# No guest resolver is needed: only the pinned proxy may be contacted; the
# proxy resolves target hosts (SOCKS5h/HTTP CONNECT), never slirp public DNS.
hosts = Path("/etc/hosts")
lines = [line for line in hosts.read_text().splitlines() if "# sub2-proxy" not in line]
lines += [ip + " " + host + " # sub2-proxy" for ip in proxy["ips"]]
hosts.write_text("\n".join(lines) + "\n")
if Path("/etc/resolv.conf").is_symlink():
    Path("/etc/resolv.conf").unlink()
Path("/etc/resolv.conf").write_text("# direct guest DNS disabled\n")
run("sysctl", "-w", "net.ipv6.conf.all.disable_ipv6=1")
env = Path("/run/sub2-kernel")
env.mkdir(mode=0o700, exist_ok=True)
os.chown(env, 10001, 10001)
# systemd EnvironmentFile syntax: quote backslashes and double quotes.
value = proxy["url"].replace("\\", "\\\\").replace('"', '\\"')
(env / "proxy.env").write_text('HTTP_PROXY="'+value+'"\nHTTPS_PROXY="'+value+'"\nALL_PROXY="'+value+'"\nNO_PROXY=localhost,127.0.0.1\n')
(env / "proxy.env").chmod(0o600)
platform = instance["spec"]["platform"]
command = "/opt/sub2-payload/kin-kernel --gateway-worker --config /run/kin/kernel.json" if platform == "claude" else "/opt/sub2-payload/kin-codex-kernel /run/kin/kernel.json"
override = Path("/etc/systemd/system/sub2-kernel.service.d")
override.mkdir(parents=True, exist_ok=True)
(override / "platform.conf").write_text("[Service]\nExecStart=\nExecStart="+command+"\n")
run("systemctl", "daemon-reload")
