[Unit]
Description=Account inference kernel inside KVM guest
Requires=sub2-setup.service
After=sub2-setup.service
[Service]
User=kincli
Environment=HOME=/home/kincli
Environment=CLAUDE_CONFIG_DIR=/home/kincli/.claude
Environment=JOB_IDLE_SECS=180
EnvironmentFile=/run/sub2-kernel/proxy.env
ExecStart=/opt/sub2-payload/kin-kernel --gateway-worker --config /run/kin/kernel.json
NoNewPrivileges=yes
Restart=no
TimeoutStopSec=20
[Install]
WantedBy=multi-user.target
