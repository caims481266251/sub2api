#!/usr/bin/python3
"""Offline operator build. Never downloads images, packages, or payloads."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import tempfile
import xml.etree.ElementTree as ET

def digest(path):
    with path.open("rb") as source:
        return hashlib.file_digest(source, "sha256").hexdigest()

def regular(path):
    if path.is_symlink() or not path.is_file():
        raise SystemExit("regular_staged_file_required: " + str(path))

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--source", type=Path, required=True, help="staged Ubuntu 24.04 amd64 UEFI cloud qcow2")
parser.add_argument("--source-sha256", required=True)
parser.add_argument("--debs", type=Path, required=True, help="offline complete dependency closure")
parser.add_argument("--payload", type=Path, required=True)
parser.add_argument("--output", type=Path, required=True, help="new artifacts directory; never overwritten")
args = parser.parse_args()
regular(args.source)
if digest(args.source) != args.source_sha256:
    raise SystemExit("source_digest_mismatch")
if args.output.exists() or args.output.is_symlink():
    raise SystemExit("output_already_exists")
packages = list(args.debs.glob("*.deb"))
if not packages:
    raise SystemExit("offline_packages_required")
for path in packages:
    regular(path)
payloads = list(args.payload.rglob("*"))
for path in payloads:
    if path.is_symlink():
        raise SystemExit("payload_symlink_forbidden")
for name in ("kin-kernel", "cli-node", "kin-codex-kernel"):
    regular(args.payload / name)
    if not (args.payload / name).stat().st_mode & 0o111:
        raise SystemExit("payload_not_executable: " + name)
info = json.loads(subprocess.check_output(["qemu-img", "info", "--output=json", str(args.source)]))
if info.get("format") != "qcow2" or info.get("backing-filename"):
    raise SystemExit("standalone_qcow2_required")
inspection = ET.fromstring(subprocess.check_output(["virt-inspector", "-a", str(args.source)]))
if inspection.findtext("./operatingsystem/arch") != "x86_64" or inspection.findtext("./operatingsystem/distro") != "ubuntu" or inspection.findtext("./operatingsystem/major_version") != "24" or inspection.findtext("./operatingsystem/minor_version") != "4":
    raise SystemExit("ubuntu_amd64_guest_required")
args.output.parent.mkdir(parents=True, exist_ok=True)
with tempfile.TemporaryDirectory(prefix="sub2-template-", dir=args.output.parent) as work:
    staging = Path(work) / "artifacts"
    staging.mkdir()
    base = staging / "base.qcow2"
    shutil.copyfile(args.source, base)
    # Package installation is deliberately offline: missing transitive packages
    # are a build failure, never a reason to enable guest internet.
    debs = Path(work) / "sub2-debs"
    debs.mkdir()
    for package in packages:
        shutil.copyfile(package, debs / package.name)
    subprocess.run(["virt-customize", "--no-network", "-a", str(base),
                    "--copy-in", str(debs) + ":/tmp",
                    "--run-command", "dpkg -i /tmp/sub2-debs/*.deb",
                    "--run-command", "test -z \"$(dpkg --audit)\" && command -v python3 && command -v cloud-init && command -v sshd && command -v systemctl && test -d /boot/efi && test -n \"$(find /lib/modules -name '9pnet_virtio.ko*' -print -quit)\"",
                    "--run-command", "rm -rf /tmp/sub2-debs; cloud-init clean --logs --machine-id"], check=True)
    subprocess.run(["qemu-img", "check", str(base)], check=True)
    shutil.copytree(args.payload, staging / "payload")
    manifest = {"base_sha256": digest(base), "source_sha256": args.source_sha256,
                "payload_sha256": {str(path.relative_to(args.payload)): digest(path) for path in payloads if path.is_file()},
                "offline_debs_sha256": {path.name: digest(path) for path in packages}}
    (staging / "template.json").write_text(json.dumps(manifest, indent=2) + "\n")
    staging.rename(args.output)
print("Staged immutable artifacts. KVM and credential acceptance gates remain false.")
