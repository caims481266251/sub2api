#!/usr/bin/python3
"""Only two fixed guest commands; never accepts arbitrary exec arguments."""
import subprocess
import sys
op = sys.argv[1] if len(sys.argv) == 2 else ""
if op not in ("apply", "observe"):
    raise SystemExit("unsupported_guest_operation")
raise SystemExit(subprocess.call([
    "ssh", "-i", "/slot/kvm/maintenance", "-p", "2222",
    "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "StrictHostKeyChecking=yes",
    "-o", "UserKnownHostsFile=/slot/kvm/known_hosts", "root@127.0.0.1",
    "/usr/local/lib/sub2-guest/control " + op,
]))
