#!/usr/bin/python3
"""Fixed per-runner egress policy. Guest slirp sockets obey this OUTPUT chain."""
import ipaddress
import json
from pathlib import Path
import subprocess
import sys

def snapshot():
    result = json.loads(subprocess.check_output(["nft", "-j", "list", "table", "inet", "sub2_egress"]))
    return [item for item in result["nftables"] if "metainfo" not in item]

stamp = Path("/run/sub2-egress-policy.json")
if sys.argv[1:] == ["--check"]:
    if snapshot() != json.loads(stamp.read_text()):
        raise SystemExit("egress_policy_changed")
    print('{"ok":true}')
    raise SystemExit(0)
if sys.argv[1:]:
    raise SystemExit("unsupported_firewall_operation")
proxy = json.loads(Path("/slot/credentials/proxy.json").read_text())
port = int(proxy["port"])
if not 1 <= port <= 65535:
    raise SystemExit("invalid_proxy_port")
ips = [str(ipaddress.IPv4Address(ip)) for ip in proxy["ips"]]
if not ips:
    raise SystemExit("proxy_ipv4_required")
rules = """table inet sub2_egress {
 chain output {
  type filter hook output priority -100; policy drop;
  oifname "lo" accept
  ct state established,related accept
"""
for ip in ips:
    rules += "  ip daddr " + ip + " tcp dport " + str(port) + " accept\n"
rules += " }\n}\n"
existing = subprocess.run(["nft", "list", "table", "inet", "sub2_egress"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
if existing.returncode == 0:
    rules = "delete table inet sub2_egress\n" + rules
subprocess.run(["nft", "-f", "-"], input=rules.encode(), check=True)
stamp.write_text(json.dumps(snapshot()))
stamp.chmod(0o600)
