#!/usr/bin/python3
import json
import time
from common import observation
# Each guest control call is short; avoid the SSH wrapper's 8s wall-clock cap.
# First boot under explicit TCG can take several minutes before SSH is ready.
deadline = time.monotonic() + 480
while True:
    try:
        print(json.dumps(observation('apply')))
        break
    except Exception:
        if time.monotonic() >= deadline:
            raise SystemExit('guest_apply_unconfirmed')
        time.sleep(1)
