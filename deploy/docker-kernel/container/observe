#!/usr/bin/python3
import hashlib
import http.client
import json
from pathlib import Path
import socket
import subprocess
from common import projection, process_identity, read, verify_kernel_isolation, verify_kernel_identity_receipt


class LocalHTTP(http.client.HTTPConnection):
    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(3)
        self.sock.connect('/slot/run/kernel.sock')


def main():
    proof = read('/run/sub2-container-applied.json')
    if proof['config_digest'] != hashlib.sha256(Path('/slot/run/codex-kernel.json').read_bytes()).hexdigest():
        raise ValueError('config_changed')
    subprocess.run(['/usr/local/lib/sub2-container/firewall','--check'], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if read('/slot/run/codex-kernel.json').get('proxy_url') != read('/slot/credentials/proxy.json')['url']:
        raise ValueError('kernel_proxy_mismatch')
    verify_kernel_isolation(Path('/proc/1/status').read_text(),
                            read('/slot/run/codex-kernel.json'),
                            read('/slot/run/instance.json'),
                            Path('/etc/machine-id').read_text(), socket.gethostname())
    process = process_identity()
    token = Path('/slot/run/internal.token').read_text().strip()
    conn = LocalHTTP('kernel')
    conn.request('GET','/internal/health',headers={'x-kin-internal-token':token,'x-internal-token':token})
    response = conn.getresponse(); health = json.loads(response.read(1048576)); conn.close()
    if response.status != 200 or health.get('healthy',health.get('ok',False)) is not True or process_identity() != process:
        raise ValueError('kernel_not_ready')
    verify_kernel_identity_receipt(health, read('/slot/run/codex-kernel.json'))
    # Keep admission fencing separate from process health. A pending credential
    # or proxy projection does not make a responding local kernel unhealthy.
    applied = False
    try:
        _, _, expected = projection()
        applied = all(proof.get(key) == value for key,value in expected.items())
    except (ValueError, OSError, KeyError):
        pass
    print(json.dumps({key:proof[key] for key in ('generation','credential_revision','proxy_revision')} | {'process':process,'kernel_ready':True,'configuration_applied':applied}))


if __name__ == '__main__':
    try: main()
    except Exception: raise SystemExit('container_observation_failed')
